[Unit]
Description=G1 Onboard Audio Driver (Microphone + Speaker)
Documentation=file:///home/unitree/g1-audio-driver/README.md
After=pulseaudio.service network-online.target
Wants=pulseaudio.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/unitree/g1-audio-driver/g1_audio_driver.py
ExecStopPost=/usr/bin/bash -c 'rm -f /tmp/g1_mic.pipe /tmp/g1_spk.pipe'
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=10
Environment=PYTHONUNBUFFERED=1
# Give the driver time to clean up PA modules on stop
TimeoutStopSec=10
# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=g1-audio-driver

[Install]
WantedBy=default.target
